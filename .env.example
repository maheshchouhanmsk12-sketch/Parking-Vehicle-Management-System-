# Database Configuration for Parking Vehicle Management System
# Aiven Cloud MySQL & Render Environment Variables

DB_SERVER=mysql-your-project-name.aivencloud.com
DB_PORT=26284
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb
DB_SSL=true
BASE_URL=

# Alternatively, you can use the complete Aiven Service URI:
# MYSQL_URL=mysql://avnadmin:your_password@mysql-your-project-name.aivencloud.com:26284/defaultdb?ssl-mode=REQUIRED
